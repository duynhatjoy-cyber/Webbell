{
  "framework": "vite",
  "installCommand": "rm -rf node_modules package-lock.json && npm install",
  "buildCommand": "node ./node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|vendor/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
